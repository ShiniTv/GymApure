# Variables para Railway → Project → Service gymapure → Variables
# Guía: docs/DEPLOY-RAILWAY.md
#
# Railway inyecta PORT automáticamente — no lo fijes a 3000 en prod.
#
# Obligatorias (secretos — pegar desde .env.prod / antiguo Render):
# JWT_SECRET=<openssl rand -base64 48>
# DATABASE_URL=postgresql://postgres.ffjwvlcwhyskddqqojnp:...@...pooler.supabase.com:6543/postgres
# SUPABASE_SERVICE_ROLE_KEY=<service_role prod>
# CRON_SECRET=<openssl rand -base64 32>
#
# Tras el primer deploy, copia la URL pública de Railway:
PUBLIC_APP_URL=https://YOUR-SERVICE.up.railway.app
REQUIRE_MFA_FOR_STAFF=false
ENABLE_HIBP_CHECK=true
#
# Redis (recomendado):
# Opción A — Railway plugin Redis → REDIS_URL se inyecta solo
# Opción B — Upstash → pegar rediss://…
# REDIS_URL=redis://...
#
# TLS Postgres (recomendado):
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
#
# Observabilidad (recomendado; VITE_* debe existir en el build):
# SENTRY_DSN=<dsn-node>
# VITE_SENTRY_DSN=<dsn-browser>
#
# SMTP (recomendado / ops):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte.gymapure@gmail.com
SMTP_PASS=<contraseña-de-aplicacion-sin-espacios>
SMTP_FROM=GymApure <soporte.gymapure@gmail.com>
VAPID_SUBJECT=mailto:soporte.gymapure@gmail.com
ADMIN_NOTIFY_EMAILS=soporte.gymapure@gmail.com
#
# Push (opcional):
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
#
# Dominio custom (cuando lo tengas):
# CORS_ORIGINS=https://tudominio.com
# PUBLIC_APP_URL=https://tudominio.com
