# Variables SMTP para Render Dashboard (caribean-gym → Environment)
# Copia cada línea como KEY=VALUE. No commitees valores reales de SMTP_PASS.

PUBLIC_APP_URL=https://tudominio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@tudominio.com
SMTP_PASS=<contraseña-de-aplicacion-sin-espacios>
SMTP_FROM=GymApure <soporte@tudominio.com>
VAPID_SUBJECT=mailto:soporte@tudominio.com
ADMIN_NOTIFY_EMAILS=soporte@tudominio.com
