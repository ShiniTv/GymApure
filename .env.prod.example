# Operaciones de producción desde tu PC (npm run db:*:prod, deploy:preflight).
# Gym en vivo: GymApure – Producción — mismo que Render / hosting.
# NO uses este archivo para desarrollo diario — usa .env.dev (GymApure – Desarrollo).
# Render Dashboard tiene sus propias variables; esto es solo para CLI local.
#
# Copia a .env.prod y completa los secretos desde tu Dashboard de hosting
# o Supabase Dashboard → Settings → Database
# Alternativa Railway: scripts/deploy/railway-prod.env.example · docs/DEPLOY-RAILWAY.md
#
# Bootstrap inicial: npm run env:init
# Tras rotar password BD: npm run env:configure-prod -- <password>

NODE_ENV=production
PORT=3000
PUBLIC_APP_URL=https://tudominio.com

# Obligatorios — pegar valores reales (nunca commitear .env.prod)
JWT_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_base64_48
DATABASE_URL=postgresql://postgres.TU_PROD_PROJECT_REF:CHANGEME@aws-1-us-west-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=CHANGEME_PROD_SERVICE_ROLE_KEY
CRON_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_base64_32

# Recomendado en Render (Key Value / Redis) o Upstash
# REDIS_URL=redis://...

# Observabilidad de errores y Core Web Vitals (misma clave en hosting, expuesta al cliente).
# SENTRY_DSN=https://publicKey@org.ingest.sentry.io/projectId
# VITE_SENTRY_DSN=https://publicKey@org.ingest.sentry.io/projectId

# SMTP (recuperar contraseña, bienvenida, pagos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@tudominio.com
SMTP_PASS=CHANGEME_APP_PASSWORD
SMTP_FROM=GymApure <soporte@tudominio.com>

# Opcional — análisis de comida por foto (Gemini Flash). Solo backend.
# GEMINI_API_KEY=CHANGEME
VAPID_SUBJECT=mailto:soporte@tudominio.com
# Generar: npx tsx scripts/deploy/ensure-vapid-prod.ts  (escribe en .env.prod)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
ADMIN_NOTIFY_EMAILS=soporte@tudominio.com

# HIBP recomendado en prod. MFA es opcional: staff puede activarlo en /security.
# Cuando quieras obligarlo: REQUIRE_MFA_FOR_STAFF=true (+ enrolar staff antes del deploy).
REQUIRE_MFA_FOR_STAFF=false
ENABLE_HIBP_CHECK=true
# openssl rand -base64 32 — cifrar mfa_secret at-rest (si falta, se deriva de JWT_SECRET)
# MFA_ENCRYPTION_KEY=CHANGEME_BASE64_32_BYTES
# CORS_ORIGINS=https://caribean-gym.onrender.com
